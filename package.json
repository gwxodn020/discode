{
  "name": "discord-code-local",
  "productName": "Discord Code",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/adapter.test.js test/package.test.js",
    "pack": "electron-builder --dir --publish never",
    "perf": "node test/performance.cjs --check",
    "icons": "node scripts/icons.cjs",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "smoke:packaged": "node test/packaged.cjs",
    "checksums": "node scripts/checksums.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "local.discord-code",
    "files": [
      "main.js",
      "preload.js",
      "adapter.js",
      "model.js",
      "ui/**/*",
      "assets/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "artifactName": "Discode-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Discode-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": null
  },
  "description": "A local code-editor view for your Discord web session",
  "author": "Local workspace",
  "dependencies": {
    "@vscode/codicons": "0.0.46-24"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gwxodn020/discode.git"
  }
}
